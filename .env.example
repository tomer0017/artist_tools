# Studio Companion — environment variables.
#
# Copy to .env.local for development (git-ignored). On the server the values
# live in a root-owned env file read by systemd, never in the repository.
# Every environment (development, staging, production) has its own database,
# Google OAuth client and secret.

# Public base URL of this deployment; Google redirects back to
# <BETTER_AUTH_URL>/api/auth/callback/google, which must be registered in the
# Google Cloud OAuth client. Use https:// everywhere except localhost.
BETTER_AUTH_URL=http://localhost:8080

# Signs session cookies and encrypts stored OAuth data. At least 32 random
# characters, different per environment: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Google Cloud Console → Google Auth Platform → Clients (type: Web application).
# Leave both empty until the client exists (sign-in then says it is not set up).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may CREATE an account with Google (existing accounts can always sign in).
# AUTH_SIGNUP_MODE:
#   invite (default) → only the addresses in AUTH_SIGNUP_ALLOWLIST, once Google
#                      has verified them; an empty list lets nobody in
#   open             → public registration: any Google-verified address gets a
#                      new account (only when deliberately opened)
# New accounts are always role "user" on the Free plan, marketing consent off.
# This only gates sign-up; identity stays the Google account id, and no role or
# permission is ever derived from an email address. (Older files that set
# AUTH_SIGNUP_ALLOWLIST=* and no mode mean "open".)
AUTH_SIGNUP_MODE=invite
AUTH_SIGNUP_ALLOWLIST=

# Which deployment this is: development, test, staging or production. Leave it
# unset only where nothing risky is enabled: the mail outbox below requires
# development, test or staging and is refused everywhere else.
APP_ENV=development

# Email + password sign-in (off unless "on"). Needs a mail transport: the
# address must be confirmed by email before the account can be used, and
# passwords are reset by email. The same AUTH_SIGNUP_MODE gate applies.
AUTH_EMAIL_PASSWORD=off

# How account email (confirmations, resets, security notices) is delivered:
#   disabled (default) → nothing is sent (email features stay off)
#   outbox             → kept for 24 h and readable by admins at /admin/mail
#                        instead of sent; development, test and staging only
# A real provider is added once one is approved (docs/adr/0004).
MAIL_TRANSPORT=disabled
# Sender shown in account email once a provider is configured.
MAIL_FROM=

# MongoDB connection string (Atlas: Clusters → Connect → Drivers) and database
# name. The database user should have readWrite on this database only.
MONGODB_URI=
MONGODB_DB=studio_companion_dev
